<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>회원가입</title>
</head>
<body>
    <h1>회원가입</h1>
    <form name="reg" action="", method="post">
        <table>
            <tr>
                <td>아이디</td>
                <td>
                    <input type="text" name="userid" placeholder="사용할 아이디 입력" required>
                </td>
            </tr>
            <tr>
                <td>비밀번호</td>
                <td>
                    <input type="password" name="passwd" placeholder="사용할 비밀번호 입력" required>
                </td>
            </tr>
            <tr>
                <td>닉네임</td>
                <td>
                    <input type="text" name="name" placeholder="사용할 닉네임 입력" required>
                </td>
            </tr>
            <tr>
                <td>이메일</td>
                <td>
                    <input type="text" name="email" placeholder="이메일 주소 입력" required>
                </td>
            </tr>
            <tr>
                <td colspan="2"><input type="reset" value="초기화"><input type="submit" value="가입"></td>
            </tr>
        </table>
    </form>
</body>
</html>